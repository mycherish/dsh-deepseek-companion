{
  "name": "dsh-deepseek-companion",
  "version": "0.1.0-preview.2",
  "description": "DeepSeek Web Companion plugin for DeepSeek Harness (DSH)",
  "type": "module",
  "license": "MIT",
  "author": "caelum-maple",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mycherish/dsh-deepseek-companion.git"
  },
  "homepage": "https://github.com/mycherish/dsh-deepseek-companion#readme",
  "bugs": {
    "url": "https://github.com/mycherish/dsh-deepseek-companion/issues"
  },
  "icon": "market/icons/companion.svg",
  "engines": {
    "node": ">=22",
    "dsh": "0.1.5-rc.2 || 0.2.1-rc.2"
  },
  "packageManager": "pnpm@10.26.0",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "lib/client.js",
    "lib/client.d.ts",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "market/icons/companion.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"*.{ts,json}\" \"docs/**/*.md\" \"market/**/*.{json,md}\" README.md CHANGELOG.md AGENTS.md",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"*.{ts,json}\" \"docs/**/*.md\" \"market/**/*.{json,md}\" README.md CHANGELOG.md AGENTS.md",
    "lint": "biome lint src tests --error-on-warnings",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsdown && tsdown --config tsdown.client.config.ts",
    "test": "node --test tests/*.test.ts"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "cordis",
    "plugin",
    "web-companion"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-plugin-market-index": "0.2.1-rc.2",
    "@types/node": "^22.10.1",
    "@types/react": "~18.3.31",
    "@types/react-dom": "~18.3.7",
    "prettier": "3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsdown": "^0.23.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "playwright": "1.62.0"
  }
}
